# ---- Ananta Legal backend configuration ----
# Copy to ".env" for local dev (".env" is git-ignored), or set these as
# environment variables on Render. DO NOT put real secrets in this example file.

# PostgreSQL connection string (stores blog posts AND admin sessions).
# Render Postgres gives you an "Internal Database URL" (works on Render) and an
# "External Database URL" (use this one for local dev).
DATABASE_URL=

# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin credentials for the blog editor. Login is disabled until ADMIN_PASSWORD is set.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Image storage. Get this from your Cloudinary dashboard (Account Details).
# Without it, images are saved to local disk — fine for dev, NOT for Render
# (Render's disk is wiped on every deploy/restart).
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Set to "true" to have the API server also serve the built React app (dist/).
# Use this for a single Render Web Service (recommended).
SERVE_CLIENT=true

# Only needed if the frontend is deployed as a SEPARATE site (different domain):
# CLIENT_ORIGIN=https://your-frontend.onrender.com
# Comma-separate multiple origins if you also test locally against this API:
# CLIENT_ORIGIN=https://ananta-legal.com,http://localhost:5173
# COOKIE_CROSS_SITE=true

# Render sets PORT automatically; locally the server defaults to 8787.
# NODE_ENV=production   (set on Render so the session cookie is marked Secure)

# ---- Enquiry form email (Contact page → anantalegal9@gmail.com) ----
# PREFERRED: Brevo's HTTPS API key (Brevo → SMTP & API → API Keys → Generate a
# new API key — NOT the SMTP key). Sends over port 443, which avoids raw SMTP
# ports (25/465/587) that some hosts, including Render, block/throttle outbound
# — that block is exactly what showed up as "[contact] Connection timeout" in
# logs even with fully correct SMTP credentials.
BREVO_API_KEY=
# Inbox that receives enquiries. Defaults to anantalegal9@gmail.com if unset.
MAIL_TO=anantalegal9@gmail.com

# FALLBACK only (used when BREVO_API_KEY is unset): plain SMTP. Works fine
# locally; on Render this can hang/timeout even with correct credentials.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# "From" address on outgoing mail — MUST be an address on a domain you've
# verified with your SMTP provider (SPF/DKIM/DMARC), e.g. no-reply@ananta-legal.com.
# Do NOT use a @gmail.com/@yahoo.com/@outlook.com address here: those providers'
# strict DMARC policies will silently reject mail sent "from" them by anyone else,
# regardless of sender verification. MAIL_TO above can still be a Gmail inbox —
# only the FROM domain is restricted.
MAIL_FROM=no-reply@ananta-legal.com

# ---- Frontend build (only needed for a SEPARATE static-host deploy) ----
# If the React app is built and uploaded elsewhere (e.g. cPanel static hosting)
# while this API runs on its own host (e.g. Render), set this to the API's
# public URL (no trailing slash) BEFORE running `npm run build`, so the built
# dist/ knows where to send requests. Leave unset for a single-service deploy
# or local dev (requests then stay same-origin / go through the Vite proxy).
# VITE_API_URL=https://your-backend.onrender.com
